# ==============================================================================
# QuantPulse Backend: Environment Variables Template
# ==============================================================================

# Server
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=quantpulse

# Native C++20 Quantitative Engine
QUANTPULSE_ENGINE_PATH=../cpp-engine/build-release/quantpulse_cli

# Active Market Data Provider (simulated | alphavantage | polygon | binance | zerodha | upstox | custom_webhook)
MARKET_DATA_PROVIDER=simulated

# External Vendor API Keys
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
CUSTOM_EXCHANGE_WEBHOOK_URL=
CUSTOM_EXCHANGE_API_KEY=
